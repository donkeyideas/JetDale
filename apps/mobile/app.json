{
  "expo": {
    "name": "Jetdale",
    "slug": "jetdale",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "jetdale",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4F1EA"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jetdale.app",
      "associatedDomains": ["applinks:jetdale.com"],
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Jetdale uses your microphone for voice input during project discovery."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F4F1EA"
      },
      "package": "com.jetdale.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "jetdale.com"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "permissions": ["android.permission.RECORD_AUDIO"]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#FF5B1F"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Jetdale needs microphone access for voice input."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
